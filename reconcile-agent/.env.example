# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# --- Webhook mode (§12.4) ---
RAZORPAY_WEBHOOK_SECRET=whsec_...
WEBHOOK_MICRO_BATCH_THRESHOLD=10
WEBHOOK_MICRO_BATCH_INTERVAL_SECONDS=300

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./reconcile.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/reconcile

# --- LLM: OpenRouter (primary) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LLM: Gemini (fallback) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# --- LLM behavior ---
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1

# --- API Security & Rate Limiting ---
API_KEY=
API_KEY_ENABLED=false
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_RATE=1.0
MAX_UPLOAD_SIZE_BYTES=104857600
QA_MAX_QUESTION_LENGTH=4000
CORS_ALLOWED_ORIGINS=*

# --- Redis Rate Limiting (Provider-Agnostic) ---
# Option 1: Any Redis provider via standard URL (AWS ElastiCache, Redis Cloud, Docker, Azure, Dragonfly)
REDIS_URL=
# Example: redis://default:password@localhost:6379/0 or rediss://...

# Option 2: Upstash Redis REST API (Optional for serverless/HTTP environments)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Testing & Fixtures ---
USE_FIXTURES=0
